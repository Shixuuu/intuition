     },
     "as_of": {
      "type": "string",
      "description": "YYYY-MM or YYYY-MM-DD, what was true then"
     },
     "type": {
      "type": "string",
      "description": "person|org|preference|topic|decision|workstream|procedure"
     }
    },
    "required": [
     "queries"
    ]
   }
  },
  {
   "name": "memory_read",
   "description": "Read one full memory record by id or name.",
   "parameters": {
    "type": "object",
    "properties": {
     "id_or_name": {
      "type": "string"
     }
    },
    "required": [
     "id_or_name"
    ]
   }
  }
 ]
}
